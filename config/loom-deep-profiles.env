# LOOM DEEP local UOPT-002 profile. All paths are repository-relative.
# FAST is archived externally and is not a locally runnable profile.
LOOM_DEEP_HOST="127.0.0.1"
LOOM_DEEP_PORT="18080"
LOOM_DEEP_CTX="4096"
LOOM_DEEP_PARALLEL="1"
LOOM_DEEP_SLOTS="32"
LOOM_DEEP_MOE_LAYERS="48"
LOOM_DEEP_CACHE_RAM="512"
LOOM_DEEP_UNLOCKED_UBATCH="4"
LOOM_DEEP_UNLOCKED_ROLLBACK_UBATCH="2"

# The original UOPT-001 source GGUF remains the model argument and rollback
# source. The sidecar contains only a lossless expert-major copy of its routed
# expert bytes; it is local/ignored and is read only by this isolated runtime.
LOOM_DEEP_UNLOCKED_MODEL="models/loom-deep-30b-unlocked.gguf"
LOOM_DEEP_UNLOCKED_ALIAS="loom-deep-30b-unlocked"
LOOM_DEEP_UNLOCKED_BIN=".loom/runtime/loom-uopt002/llama-server"
LOOM_DEEP_UNLOCKED_RUNTIME_LIB_DIR=".loom/runtime/loom-uopt002"
LOOM_DEEP_UNLOCKED_SIDECAR="models/unlocked-expert-major-v1.bin"
LOOM_DEEP_UNLOCKED_ROLLBACK_BIN=".loom/runtime/loom-llama-server"
