# LOOM DEEP final product profiles (WP4). All paths are repository-relative.
# Both profiles use the pinned llama.cpp S32-style serving parameters on loopback only.
LOOM_DEEP_BIN=".loom/runtime/loom-llama-server"
LOOM_DEEP_HOST="127.0.0.1"
LOOM_DEEP_PORT="18080"
LOOM_DEEP_CTX="4096"
LOOM_DEEP_PARALLEL="1"
LOOM_DEEP_SLOTS="32"
LOOM_DEEP_MOE_LAYERS="48"
LOOM_DEEP_CACHE_RAM="512"

LOOM_DEEP_FAST_MODEL="models/loom-deep-30b-fast.gguf"
LOOM_DEEP_FAST_ALIAS="loom-deep-30b-s32"
LOOM_DEEP_UNLOCKED_MODEL="models/loom-deep-30b-unlocked.gguf"
LOOM_DEEP_UNLOCKED_ALIAS="loom-deep-30b-unlocked"
