# LOOM WP1 local-only serving configuration. Paths are repository-relative.
# Compatibility lifecycle profile. The unified WP4 manager is scripts/loom-deep.
LOOM_DEEP_BIN=".loom/runtime/loom-llama-server"
LOOM_DEEP_MODEL="models/loom-deep-30b-fast.gguf"
LOOM_DEEP_HOST="127.0.0.1"
LOOM_DEEP_PORT="18080"
LOOM_DEEP_ALIAS="loom-deep-30b-s32"
LOOM_DEEP_CTX="4096"
LOOM_DEEP_SLOTS="32"
LOOM_DEEP_MOE_LAYERS="48"
LOOM_DEEP_PARALLEL="1"
