#!/usr/bin/env bash
# Retired WP1 FAST lifecycle entry point. FAST is archived and unavailable locally.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

case "${1:-}" in
  start)
    echo "FAST is archived; use $ROOT/scripts/loom-deep start for local UOPT-002 UNLOCKED serving" >&2
    exit 64
    ;;
  stop)
    echo "legacy FAST lifecycle is retired; no FAST server is managed"
    ;;
  status|health)
    exec "$ROOT/scripts/loom-deep" "$1"
    ;;
  *)
    echo "usage: $0 {start|stop|status|health}; start is retired because FAST is archived" >&2
    exit 64
    ;;
esac
