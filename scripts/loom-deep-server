#!/usr/bin/env bash
# Local-only LOOM DEEP llama-server lifecycle helper (WP1).
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=/dev/null
source "$ROOT/config/loom-deep-server.env"
RUNTIME_DIR="$ROOT/results-local/runtime-productization-wp1/live"
PID_FILE="$RUNTIME_DIR/llama-server.pid"
LOG_FILE="$RUNTIME_DIR/llama-server.log"
mkdir -p "$RUNTIME_DIR"
url="http://${LOOM_DEEP_HOST}:${LOOM_DEEP_PORT}"

running() {
  [[ -s "$PID_FILE" ]] && kill -0 "$(<"$PID_FILE")" 2>/dev/null
}

case "${1:-status}" in
  start)
    if running; then
      echo "already running: pid $(<"$PID_FILE") $url"; exit 0
    fi
    rm -f "$PID_FILE"
    [[ -x "$ROOT/$LOOM_DEEP_BIN" ]] || { echo "missing executable: $LOOM_DEEP_BIN" >&2; exit 1; }
    [[ -f "$ROOT/$LOOM_DEEP_MODEL" ]] || { echo "missing model: $LOOM_DEEP_MODEL" >&2; exit 1; }
    (
      cd "$ROOT"
      exec "$ROOT/$LOOM_DEEP_BIN" \
        --offline --host "$LOOM_DEEP_HOST" --port "$LOOM_DEEP_PORT" --alias "$LOOM_DEEP_ALIAS" \
        --ctx-size "$LOOM_DEEP_CTX" --parallel "$LOOM_DEEP_PARALLEL" \
        --moe-n-slots "$LOOM_DEEP_SLOTS" --moe-n-layers "$LOOM_DEEP_MOE_LAYERS" \
        --no-mmap --no-warmup --cpu-moe -b "$LOOM_DEEP_CTX" -ub 1 --cache-ram 512 --no-ui-mcp-proxy \
        --model "$ROOT/$LOOM_DEEP_MODEL" --log-file "$LOG_FILE"
    ) >>"$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
    for _ in $(seq 1 180); do
      if curl --silent --fail "$url/health" >/dev/null; then
        echo "started: pid $(<"$PID_FILE") $url"; exit 0
      fi
      if ! running; then echo "server exited; inspect $LOG_FILE" >&2; exit 1; fi
      sleep 1
    done
    echo "server did not become healthy; inspect $LOG_FILE" >&2; exit 1
    ;;
  stop)
    if ! running; then rm -f "$PID_FILE"; echo "not running"; exit 0; fi
    pid="$(<"$PID_FILE")"; kill -TERM "$pid"
    for _ in $(seq 1 30); do kill -0 "$pid" 2>/dev/null || { rm -f "$PID_FILE"; echo "stopped"; exit 0; }; sleep 1; done
    echo "did not stop pid $pid; refusing to SIGKILL" >&2; exit 1
    ;;
  status)
    if running; then
      echo "running: pid $(<"$PID_FILE") $url"
      curl --silent --fail "$url/health" || true
    else
      rm -f "$PID_FILE"; echo "not running: $url"; exit 1
    fi
    ;;
  health) curl --silent --fail "$url/health" ;;
  *) echo "usage: $0 {start|stop|status|health}" >&2; exit 64 ;;
esac
