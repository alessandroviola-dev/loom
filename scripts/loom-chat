#!/usr/bin/env bash
set -euo pipefail

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
STATE="$ROOT/.loom/runtime/loom-chat"
PID_FILE="$STATE/proxy.pid"
LOG_FILE="$STATE/proxy.log"
URL="${LOOM_CHAT_URL:-http://127.0.0.1:18082}"
STATUS_URL="$URL/loom/chat-continuity/status"
UPSTREAM_STATUS="http://127.0.0.1:18080/loom/context-engine/status"
CLIENT_DIR="$ROOT/.loom/runtime/loom-deep/forgeloom-clients"

mkdir -p "$STATE"

pid_running() {
  [[ -s "$PID_FILE" ]] && kill -0 "$(<"$PID_FILE")" 2>/dev/null
}

prune_forgeloom_clients() {
  local file pid
  [[ -d "$CLIENT_DIR" ]] || return 0
  for file in "$CLIENT_DIR"/*; do
    [[ -f "$file" ]] || continue
    pid="$(cat "$file" 2>/dev/null || true)"
    if [[ ! "$pid" =~ ^[0-9]+$ ]] || ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$file"
    fi
  done
}

forgeloom_active() {
  prune_forgeloom_clients
  local file
  for file in "$CLIENT_DIR"/*; do
    [[ -f "$file" ]] && return 0
  done
  return 1
}

gateway_safe() {
  local status
  status="$(curl -fsS --max-time 2 "$UPSTREAM_STATUS" 2>/dev/null)" || return 1
  python3 - "$status" <<'PY'
import json, sys
try:
    data = json.loads(sys.argv[1])
except Exception:
    raise SystemExit(1)
ok = (
    data.get("contextEngineGateway") is True
    and data.get("hardGuardEnabled") is True
    and data.get("guardFailClosed") is True
    and data.get("safeTotalTokens") == 3600
    and data.get("safeInputTokens") == 2800
    and data.get("minOutputTokens") == 800
    and data.get("maxOutputTokens") == 1600
    and data.get("physicalContextTokens") == 4096
)
raise SystemExit(0 if ok else 1)
PY
}

ensure_upstream() {
  if gateway_safe; then return 0; fi
  if forgeloom_active; then
    echo "LoomChat cannot restart the shared LOOM backend while ForgeLoom is active. Exit ForgeLoom first." >&2
    exit 1
  fi
  "$ROOT/scripts/loom-deep" stop >/dev/null 2>&1 || true
  env \
    LOOM_CONTEXT_WEBUI_GATEWAY=1 \
    LOOM_CONTEXT_WEBUI_CI=0 \
    LOOM_CONTEXT_WEBUI_ACCOUNTING=1 \
    LOOM_CONTEXT_WEBUI_HARD_GUARD=1 \
    LOOM_CONTEXT_WEBUI_GUARD_FAIL_CLOSED=1 \
    LOOM_CONTEXT_WEBUI_SAFE_TOTAL_TOKENS=3600 \
    LOOM_CONTEXT_WEBUI_SAFE_INPUT_TOKENS=2800 \
    LOOM_CONTEXT_WEBUI_MIN_OUTPUT_TOKENS=800 \
    LOOM_CONTEXT_WEBUI_MAX_OUTPUT_TOKENS=1600 \
    "$ROOT/scripts/loom-deep" start
  gateway_safe || { echo "LOOM hard-guard gateway did not enter the required safe state." >&2; exit 1; }
}

start_proxy() {
  if pid_running; then return 0; fi
  rm -f "$PID_FILE"
  (
    exec env \
      LOOM_CHAT_CONTINUITY=1 \
      LOOM_CHAT_HOST=127.0.0.1 \
      LOOM_CHAT_PORT=18082 \
      LOOM_CHAT_UPSTREAM_HOST=127.0.0.1 \
      LOOM_CHAT_UPSTREAM_PORT=18080 \
      LOOM_CHAT_HIGH_WATER_TOKENS="${LOOM_CHAT_HIGH_WATER_TOKENS:-1800}" \
      LOOM_CHAT_TARGET_TOKENS="${LOOM_CHAT_TARGET_TOKENS:-1400}" \
      LOOM_CHAT_RETRIEVAL_CHARS="${LOOM_CHAT_RETRIEVAL_CHARS:-520}" \
      LOOM_CHAT_RETRIEVAL_ITEMS="${LOOM_CHAT_RETRIEVAL_ITEMS:-2}" \
      LOOM_CHAT_RUNTIME_DIR="$STATE" \
      node "$ROOT/scripts/loom-chat-proxy.mjs"
  ) >>"$LOG_FILE" 2>&1 &
  echo $! > "$PID_FILE"

  for _ in $(seq 1 50); do
    curl -fsS --max-time 1 "$STATUS_URL" >/dev/null 2>&1 && return 0
    sleep 0.1
  done
  echo "LoomChat proxy did not become healthy. Inspect: $LOG_FILE" >&2
  if pid_running; then kill "$(<"$PID_FILE")" 2>/dev/null || true; fi
  rm -f "$PID_FILE"
  exit 1
}

stop_proxy() {
  if pid_running; then
    kill "$(<"$PID_FILE")" 2>/dev/null || true
    for _ in $(seq 1 30); do
      kill -0 "$(<"$PID_FILE")" 2>/dev/null || break
      sleep 0.1
    done
  fi
  rm -f "$PID_FILE"
}

open_chat() {
  if command -v open >/dev/null 2>&1; then
    open "$URL" >/dev/null 2>&1 || true
  fi
  echo "LoomChat: $URL"
}

case "${1:-start}" in
  start|open)
    ensure_upstream
    start_proxy
    open_chat
    ;;
  stop)
    stop_proxy
    if ! forgeloom_active; then "$ROOT/scripts/loom-deep" stop >/dev/null 2>&1 || true; fi
    echo "LoomChat stopped"
    ;;
  status)
    if pid_running && curl -fsS --max-time 1 "$STATUS_URL"; then
      echo
      gateway_safe && echo "LOOM hard guard: OK" || echo "LOOM hard guard: NOT SAFE"
    else
      rm -f "$PID_FILE"
      echo "LoomChat not running"
      exit 1
    fi
    ;;
  *)
    echo "usage: $0 {start|open|stop|status}" >&2
    exit 64
    ;;
esac
