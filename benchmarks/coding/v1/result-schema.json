{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LOOM Coding Benchmark 01 Result",
  "type": "object",
  "required": ["benchmark", "version", "timestamp_utc", "model", "runtime", "backend", "mode", "context", "score", "max_score", "tasks"],
  "properties": {
    "benchmark": {"type": "string"},
    "version": {"type": "string"},
    "timestamp_utc": {"type": "string"},
    "model": {"type": "string"},
    "runtime": {"type": "string"},
    "backend": {"type": "string"},
    "mode": {"enum": ["single_shot", "agentic", "unknown"]},
    "context": {"type": ["string", "integer"]},
    "score": {"type": "number", "minimum": 0, "maximum": 100},
    "max_score": {"const": 100},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "skill", "points_available", "points_earned", "tests_total", "tests_passed", "duration_seconds"],
        "properties": {
          "id": {"type": "string"},
          "skill": {"type": "string"},
          "points_available": {"type": "number"},
          "points_earned": {"type": "number"},
          "tests_total": {"type": "integer"},
          "tests_passed": {"type": "integer"},
          "duration_seconds": {"type": "number"}
        }
      }
    }
  }
}
